# ─── Serveur ─────────────────────────────────────────────
PORT=4000
# development en local, production en ligne
NODE_ENV=development

# ─── CORS ────────────────────────────────────────────────
# Origines autorisées à appeler l'API (le site), séparées par des virgules. En ligne : l'adresse du site.
CORS_ORIGIN=http://localhost:5173

# ─── PostgreSQL ──────────────────────────────────────────
# Format : postgresql://user:password@host:port/dbname
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/lmd
# true pour une base distante qui exige SSL (Neon, Supabase, Render...)
DATABASE_SSL=false

# ─── Cloudinary (stockage médias, obligatoire en ligne) ──
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── Auth admin (JWT) ────────────────────────────────────
# En production : au moins 32 caractères aléatoires
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d

# ─── Site public ─────────────────────────────────────────
# Adresse du site (hébergé à part), sans / final. Ex. https://lamaisondany.netlify.app
# FRONTEND_URL : l'API s'en sert pour fabriquer les pages produit avec leur aperçu WhatsApp
FRONTEND_URL=
# PUBLIC_SITE_URL : adresse publique définitive (sitemap, liens canoniques). Défaut : FRONTEND_URL
PUBLIC_SITE_URL=
# Seulement pour servir un site compilé depuis l'API (hébergement en un seul service). Laisser vide sinon.
FRONTEND_DIST=

# ─── Photos stockées localement (seulement sans Cloudinary) ─
# URL publique de l'API, ex. https://api.monsite.com
PUBLIC_URL=

# ─── WhatsApp ────────────────────────────────────────────
# Le numéro se règle dans l'admin (Contenu du site > Général). Valeur de secours :
WHATSAPP_NUMBER=237690000000
